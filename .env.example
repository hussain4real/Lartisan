APP_NAME=Lartisan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
LARTISAN_WAITLIST_HOSTS=lartisan.app,www.lartisan.app
LARTISAN_ADMIN_HOST=
LARTISAN_QUEUE_WORKER_COMMAND="php artisan queue:work --queue=default --sleep=3 --tries=3 --timeout=60"
LARTISAN_SCHEDULER_COMMAND="php artisan schedule:run"
LARTISAN_SCHEDULER_CACHE_STORE=database
LARTISAN_PRIVATE_MEDIA_URL_EXPIRATION_MINUTES=10
LARTISAN_ACCOUNT_CLAIMS_PER_MINUTE=5
LARTISAN_BOOKING_TRACKER_ACTIONS_PER_MINUTE=10
LARTISAN_MARKETPLACE_BOOKINGS_PER_MINUTE=6
LARTISAN_MEDIA_UPLOADS_PER_MINUTE=12
LARTISAN_OTP_REQUESTS_PER_MINUTE=4
LARTISAN_PAYSTACK_WEBHOOKS_PER_MINUTE=120
LARTISAN_WAITLIST_SUBMISSIONS_PER_MINUTE=6
LARTISAN_WHATSAPP_WEBHOOKS_PER_MINUTE=120
LARTISAN_BOOKING_COMMISSION_BASIS_POINTS=1000
LARTISAN_BOOKING_PROVIDER_FEE_BASIS_POINTS=150
LARTISAN_BOOKING_PROVIDER_FEE_FLAT_AMOUNT=10000
LARTISAN_NOTIFICATION_CHANNELS=email,whatsapp
LARTISAN_EMAIL_NOTIFICATIONS_ENABLED=true
LARTISAN_WHATSAPP_NOTIFICATIONS_ENABLED=false
LARTISAN_WHATSAPP_BASE_URL=
LARTISAN_WHATSAPP_TOKEN=
LARTISAN_WHATSAPP_WEBHOOK_SECRET=
LARTISAN_WHATSAPP_TIMEOUT=5
LARTISAN_WHATSAPP_CONNECT_TIMEOUT=3
LARTISAN_WHATSAPP_RETRY_TIMES=2
LARTISAN_WHATSAPP_RETRY_SLEEP_MILLISECONDS=200

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_PORTFOLIO_DISK=public
MEDIA_PRIVATE_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@lartisan.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MEDIA_PUBLIC_ACCESS_KEY_ID=
MEDIA_PUBLIC_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_DEFAULT_REGION=us-east-1
MEDIA_PUBLIC_BUCKET=
MEDIA_PUBLIC_URL=
MEDIA_PUBLIC_ENDPOINT=
MEDIA_PUBLIC_USE_PATH_STYLE_ENDPOINT=false

MEDIA_PRIVATE_ACCESS_KEY_ID=
MEDIA_PRIVATE_SECRET_ACCESS_KEY=
MEDIA_PRIVATE_DEFAULT_REGION=us-east-1
MEDIA_PRIVATE_BUCKET=
MEDIA_PRIVATE_URL=
MEDIA_PRIVATE_ENDPOINT=
MEDIA_PRIVATE_USE_PATH_STYLE_ENDPOINT=false

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co

VITE_APP_NAME="${APP_NAME}"
